{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Mode",
  "version": "1.3.0",
  "identifier": "ai.arena.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://raw.githubusercontent.com https://cdn.jsdelivr.net; frame-src https://arena.ai https://*.arena.ai; media-src 'self' blob:; worker-src 'self'; object-src 'none'; base-uri 'self'",
      "freezePrototype": false
    },
    "windows": [
      {
        "label": "main",
        "title": "Agent Mode",
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "tooltip": "Agent Mode"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Arena Agent native shell",
    "longDescription": "Opens arena.ai/agent as a system app instead of a browser.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["arena-agent"]
      }
    }
  }
}
