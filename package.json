{
  "name": "arena-agent",
  "private": true,
  "version": "1.2.0",
  "description": "Arena Agent native shell — opens https://arena.ai/agent as an app, not a browser.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 1420 --strictPort",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build && npx cap sync",
    "zip": "node scripts/zip.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.0",
    "@capacitor/core": "8.5.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "2.3.3",
    "@tauri-apps/plugin-notification": "2.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@tauri-apps/cli": "2.11.4",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
